F:=GF(4611686018427388039);
P<x0,x1,x2,x3,x4,x5>:=PolynomialRing(F,6);
ps:=[-3*x0^3 + 4*x0^2*x1 + 8*x0^2 - 3*x0*x1^2 - 8*x0*x1 - x0 + 2*x1^3 - x1^2 + 3*x1 - x2^3,
2*x0^3 - x0^2*x1 + x0^2 + 2*x0*x1^2 - 2*x0*x1 - 8*x0 - 3*x1^3 - x1^2 - 6*x1 - x3^3 - 2,
7*x0^3 - x0^2*x1 - 7*x0^2 + 6*x0*x1^2 - 4*x0*x1 + 8*x0 + 2*x1^3 - 6*x1^2 - 7*x1 - x4^3 - 1,
2*x0^3 + 4*x0^2*x1 + x0*x1^2 + 7*x0*x1 - 2*x0 + 7*x1^3 - 6*x1^2 + 2*x1 - x5^3 + 1,
4*x2^3 + 3*x2^2*x3 + 4*x2^2 + 6*x2*x3^2 + 2*x2*x3 - 6*x2 + 7*x3^3 - 6*x3^2 + 5*x3 + 8*x4 + 6*x5 - 4,
4*x2^3 - 3*x2^2*x3 + x2^2 - 8*x2*x3^2 + 3*x2*x3 - 2*x2 - 3*x3^3 + 3*x3^2 - 3*x3 - 8*x4 + 8*x5 - 1];
I:=ideal<P|ps>;
time G:=GroebnerBasis(I);