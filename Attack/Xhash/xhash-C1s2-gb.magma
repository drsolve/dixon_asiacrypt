F:=GF(4611686018427388039);
P<x0,x1,x2,x3,x4,x5,x6>:=PolynomialRing(F,7);
ps:=[-7*x0^3 + 8*x0^2 + 8*x0 - x1^3 + 4,
-x0^3 + 3*x0^2 - 3*x0 - x2^3 - 5,
8*x0^3 + 5*x0^2 - 8*x0 - x3^3 - 7,
-3*x1^2*x2 + 4*x1^2*x3 - 4*x1^2 + 5*x1*x2^2 + 5*x1*x2*x3 - 8*x1*x2 + x1*x3^2 + 2*x1*x3 - 5*x1 + 5*x2^3 + 6*x2^2*x3 + 6*x2^2 - 7*x2*x3^2 - 5*x2*x3 + 7*x2 - 7*x3^3 + 5*x3^2 - 7*x3 - x4 + 7,
-x1^3 - 3*x1^2*x2 - 2*x1^2*x3 + 7*x1^2 - 4*x1*x2^2 + x1*x2*x3 - 6*x1*x2 - 3*x1*x3^2 + 4*x1*x3 + 8*x1 - 3*x2^3 - x2^2*x3 - 2*x2^2 + 7*x2*x3^2 - x2*x3 + 8*x2 + 7*x3^3 + 2*x3^2 - 2*x3 - x5,
-7*x1^3 - 7*x1^2*x2 - 2*x1^2*x3 - 7*x1^2 - 2*x1*x2^2 - 3*x1*x2 - x1*x3^2 - 7*x1*x3 - 4*x1 + 3*x2^3 - 3*x2^2*x3 - 4*x2^2 + x2*x3^2 + 3*x2*x3 - 8*x2 + 5*x3^3 - 5*x3 - x6 + 5,
-7*x4^3 - 7*x4^2*x5 + 2*x4^2*x6 - 7*x4^2 + 7*x4*x5^2 + 6*x4*x5*x6 + 2*x4*x5 + 8*x4*x6^2 + 5*x4*x6 - x4 + 8*x5^3 - 7*x5^2*x6 - 8*x5^2 - 8*x5*x6^2 - 5*x5*x6 - x6^3 + x6^2 - 7*x6 - 6];
I:=ideal<P|ps>;
time G:=GroebnerBasis(I);