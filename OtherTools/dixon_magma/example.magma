load "dixon.magma";
K:=GF(101);
R<x,y,z>:=PolynomialRing(K,3);
ps := [x+y+z^2+1,2*x+3*y+z, 8*x+7*y+z^2];
vars := [x,y];
is_interpolation := 0;
time d := dixon(ps, vars, is_interpolation);


n := 8;      // number of variables
d := 2;     // degree of polynomials
p := 65537;  // characteristic of finite field
m := 8;      // number of equations
k := 0;      // monomial density (0 means using all valid terms)
ps,vars := random_polynomial_over_finite_field(n, d, p, m, k);
is_interpolation := 1;
time T := &*ps;
time d := dixon(ps, vars, is_interpolation);
//Roots(d);


R := Parent(vars[1]);
I := ideal<R|ps>;
time Dimension(I);
time G := GroebnerBasis(I);
g := G[#G];


GF2:=FiniteField(2);
GF2_polyring<z8>:=PolynomialRing(GF2);
irr_poly:=z8^8 + z8^4 + z8^3 + z8 + 1;
GF2_n<z8>:=ext<GF2|irr_poly>;
GF2_n_poly_ring<x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10>:=PolynomialRing(GF2_n,11);

p0 := (z8^7 + z8^5 + z8^4 + z8^2)*x1^4*x3^4 + (z8^7 + z8^6 + z8^5 + z8^3 + z8^2 + z8)*x2^4*x3^4 + (z8^5 + z8)*x1^4*x3^2 + (z8^5 + z8^4 + z8 + 1)*x2^4*x3^2 + (z8^5 + z8)*x1^2*x3^4 + (z8^5 + z8^4 + z8 + 1)*x2^2*x3^4 + (z8^3 + 1)*x1^4*x3 + (z8^7 + z8 + 1)*x2^4*x3 + (z8^3 + 1)*x1*x3^4 + (z8^7 + z8 + 1)*x2*x3^4 + (z8^6 + z8^5 + z8)*x1^2*x3^2 + (z8^6 + z8^4 + z8 + 1)*x2^2*x3^2 + (z8^7 + z8^5 + z8^4 + 1)*x3^4 + (z8^7 + z8^3 + z8^2)*x1^2*x3 + (z8^7 + z8^6 + z8^3 + z8)*x2^2*x3 + (z8^7 + z8^3 + z8^2)*x1*x3^2 + (z8^7 + z8^6 + z8^3 + z8)*x2*x3^2 + (z8^7 + z8^5 + z8^4 + z8 + 1)*x1*x3 + (z8^6 + z8^5 + z8^2)*x2*x3 + (z8^6 + z8^5 + z8^4 + z8^3 + z8^2 + z8)*x3^2 + (z8^6 + z8^3 + z8^2 + z8)*x3 + 1;
p1 :=  (z8^7 + z8^6 + 1)*x1^4*x4^4 + (z8^7 + z8^4 + z8^3 + z8 + 1)*x2^4*x4^4 + (z8^6 + z8^5 + z8^2 + z8)*x1^4*x4^2 + (z8^6 + z8^5 + z8^4 + z8^2 + z8 + 1)*x2^4*x4^2 + (z8^6 + z8^5 + z8^2 + z8)*x1^2*x4^4 + (z8^6 + z8^5 + z8^4 + z8^2 + z8 + 1)*x2^2*x4^4 + (z8^4 + z8^3 + z8 + 1)*x1^4*x4 + (z8^7 + z8^4 + 1)*x2^4*x4 + (z8^4 + z8^3 + z8 + 1)*x1*x4^4 + (z8^7 + z8^4 + 1)*x2*x4^4 + (z8^7 + z8^5 + z8^2 + z8)*x1^2*x4^2 + (z8^7 + z8^4 + z8^2 + z8 + 1)*x2^2*x4^2 + (z8^4 + z8^2 + 1)*x4^4 + (z8^7 + z8^3 + 1)*x1^2*x4 + (z8^7 + z8^6 + z8^3 + z8^2 + z8 + 1)*x2^2*x4 + (z8^7 + z8^3 + 1)*x1*x4^2 + (z8^7 + z8^6 + z8^3 + z8^2 + z8 + 1)*x2*x4^2 + (z8^7 + z8^6 + z8^3)*x1*x4 + (z8^4 + z8^3 + z8^2 + z8 + 1)*x2*x4 + (z8^7 + z8^3 + z8)*x4^2 + (z8^7 + z8^6 + z8^5 + 1)*x4 + 1;
p2 := (z8^7 + z8^5 + z8^4 + z8^2)*x5^4*x7^4 + (z8^7 + z8^6 + z8^5 + z8^3 + z8^2 + z8)*x6^4*x7^4 + (z8^5 + z8)*x5^4*x7^2 + (z8^5 + z8^4 + z8 + 1)*x6^4*x7^2 + (z8^5 + z8)*x5^2*x7^4 + (z8^5 + z8^4 + z8 + 1)*x6^2*x7^4 + (z8^3 + 1)*x5^4*x7 + (z8^7 + z8 + 1)*x6^4*x7 + (z8^3 + 1)*x5*x7^4 + (z8^7 + z8 + 1)*x6*x7^4 + (z8^6 + z8^5 + z8)*x5^2*x7^2 + (z8^6 + z8^4 + z8 + 1)*x6^2*x7^2 + (z8^6 + z8^5 + z8^4 + z8)*x7^4 + (z8^7 + z8^3 + z8^2)*x5^2*x7 + (z8^7 + z8^6 + z8^3 + z8)*x6^2*x7 + (z8^7 + z8^3 + z8^2)*x5*x7^2 + (z8^7 + z8^6 + z8^3 + z8)*x6*x7^2 + (z8^7 + z8^5 + z8^4 + z8 + 1)*x5*x7 + (z8^6 + z8^5 + z8^2)*x6*x7 + (z8^7 + z8^6 + z8^3 + z8 + 1)*x7^2 + (z8^7 + z8^3)*x7 + 1;
p3 :=  (z8^7 + z8^6 + 1)*x5^4*x8^4 + (z8^7 + z8^4 + z8^3 + z8 + 1)*x6^4*x8^4 + (z8^6 + z8^5 + z8^2 + z8)*x5^4*x8^2 + (z8^6 + z8^5 + z8^4 + z8^2 + z8 + 1)*x6^4*x8^2 + (z8^6 + z8^5 + z8^2 + z8)*x5^2*x8^4 + (z8^6 + z8^5 + z8^4 + z8^2 + z8 + 1)*x6^2*x8^4 + (z8^4 + z8^3 + z8 + 1)*x5^4*x8 + (z8^7 + z8^4 + 1)*x6^4*x8 + (z8^4 + z8^3 + z8 + 1)*x5*x8^4 + (z8^7 + z8^4 + 1)*x6*x8^4 + (z8^7 + z8^5 + z8^2 + z8)*x5^2*x8^2 + (z8^7 + z8^4 + z8^2 + z8 + 1)*x6^2*x8^2 + (z8^5 + z8^4 + z8^3 + z8^2 + 1)*x8^4 + (z8^7 + z8^3 + 1)*x5^2*x8 + (z8^7 + z8^6 + z8^3 + z8^2 + z8 + 1)*x6^2*x8 + (z8^7 + z8^3 + 1)*x5*x8^2 + (z8^7 + z8^6 + z8^3 + z8^2 + z8 + 1)*x6*x8^2 + (z8^7 + z8^6 + z8^3)*x5*x8 + (z8^4 + z8^3 + z8^2 + z8 + 1)*x6*x8 + (z8^6 + z8^4)*x8^2 + (z8^7 + z8^6 + z8^5 + z8 + 1)*x8 + 1;
p4 :=  z8*x0*x1 + (z8^7 + z8^6 + z8^4)*x1 + 1;
p5 :=  (z8^2 + z8)*x0*x2 + (z8^7 + z8^6 + z8^5 + z8)*x2 + 1;
p6 :=  z8*x3*x5 + (z8 + 1)*x4*x5 + (z8^7 + z8^6 + z8^4 + z8^2 + 1)*x5 + 1;
p7 :=  (z8^2 + z8)*x3*x6 + (z8^2 + z8 + 1)*x4*x6 + (z8^7 + z8^6 + z8^4 + z8^3 + z8^2 + z8 + 1)*x6 + 1;
p8 :=  z8*x7*x9 + (z8 + 1)*x8*x9 + (z8^5 + z8^4 + z8^3 + z8)*x9 + 1;
p9 :=  (z8^2 + z8)*x7*x10 + (z8^2 + z8 + 1)*x8*x10 + (z8^5 + z8^4 + z8^3 + z8^2 + z8)*x10 + 1;
p10 :=   (z8^5 + 1)*x9^4 + (z8^7 + z8^5 + z8^4 + z8^3 + z8^2 + z8 + 1)*x10^4 + (z8^6 + z8^4 + z8^2 + z8)*x9^2 + (z8^6 + z8^5 + z8^4 + z8^3 + z8^2 + 1)*x10^2 + (z8^7 + z8^5 + z8^4 + 1)*x9 + (z8^6 + z8^5 + z8^2 + z8 + 1)*x10 + (z8^7 + z8^3 + z8 + 1);

time r0 := dixon([p4,p5],[x0]);
time r1 := dixon([r0,p0],[x1]);
time r2 := dixon([p0,p1],[x1]);
time r3 := dixon([r1,r2],[x2]);
time d1 := dixon([r3,p6,p7],[x3,x4]);
time r7 := Resultant(p10,p9,x10);
time r8 := Resultant(r7,p8,x9);
time r9 := Resultant(r8,p3,x8);
time r10 := Resultant(r9,p2,x7);
time r11 := Resultant(d1,r10,x5);
